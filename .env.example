# Local PostgreSQL connection. Use the internal compose hostname when running Docker.
DATABASE_URL=postgres://docudeck:41532145@localhost:5432/docudeck

# Replace this development-only value with a random secret of at least 32 characters.
# Example: openssl rand -base64 48
SESSION_SECRET=docudeck-local-only-session-secret-change-before-use

# 32-byte AES-256 key encoded as 64 hexadecimal characters.
# Generate with: openssl rand -hex 32
# Do not commit a production key or reuse this example outside local development.
DOCUMENT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Public URL used for absolute links and metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local PostgreSQL container credentials (used by docker-compose.yml).
POSTGRES_USER=docudeck
POSTGRES_PASSWORD=41532145
POSTGRES_DB=docudeck
